{% extends 'base.html.twig' %}

{% block title %}Harmonia{% endblock %}

{% block body %}
    <div class="container">
            <button id="btn-ajax-2">Boutton pour tester l'ajax 2</button>
            <button id="check-pokemon">Check pokemoi</button>
      <input type="text" id="search-album" placeholder="Entrez le nom de l'album">
      <div id="search-results"></div>

        <h1 class="text-center">Les dernières sorties</h1>

        {% include "components/album-loop.html.twig" with {
            'title': 'EP',
            'albums': eps
        } %}

        {% include "components/album-loop.html.twig" with {
            'title': 'Singles',
            'albums': singles
        } %}

        {% include "components/album-loop.html.twig" with {
            'title': 'Albums',
        } %}

    </div>
    <div class="navigation">
        {{ knp_pagination_render(albums) }}
    </div>

{% endblock %}
